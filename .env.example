# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Server
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Environment
NODE_ENV=development

# LLM provider: anthropic (default) or an open-source / OpenAI-compatible server:
#   ollama | vllm | llamacpp | lmstudio | tgi | sglang | huggingface | openrouter | together | groq | fireworks | openai_compat
LLM_PROVIDER=anthropic
# Model name as the server knows it (e.g. qwen2.5:7b for Ollama, Qwen/Qwen2.5-7B-Instruct for vLLM/HF)
LLM_MODEL=
# Override the preset URL (required for openai_compat)
LLM_BASE_URL=
LLM_API_KEY=
# Used by huggingface / openrouter / together / groq / fireworks presets
HF_TOKEN=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
GROQ_API_KEY=
FIREWORKS_API_KEY=

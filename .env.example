# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Server
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Environment
NODE_ENV=development

# ClipForge (clipforge/): Claude is used automatically when ANTHROPIC_API_KEY is set
# CLIPFORGE_MODEL=claude-opus-5-5
# CLIPFORGE_USE_LLM=auto        # auto | on | off
# YOUTUBE_API_KEY=              # optional: lets the research agent discover channels
# CLIPFORGE_SENDER_NAME=Your Name

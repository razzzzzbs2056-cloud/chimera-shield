# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Server
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Environment
NODE_ENV=development

# --- Chimera Agency (AI content company) ---
AGENCY_COMPANY_NAME=Chimera Content Co.
AGENCY_MODEL=claude-opus-5
AGENCY_EFFORT=high
AGENCY_MOCK=false
AGENCY_WORKSPACE=agency_output
# Email is a dry run (saved to agency_output/outbox) unless this is true
AGENCY_SEND_EMAILS=false
AGENCY_MAX_EMAILS=10
# Optional: comma-separated addresses or @domains the agents may email
AGENCY_EMAIL_ALLOWLIST=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

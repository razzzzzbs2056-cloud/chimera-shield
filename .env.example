# API Keys (never commit real values; .env is gitignored)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Models (see docs/company/engineering/adr-001-mvp-architecture.md)
TRIAGE_MODEL=claude-haiku-4-5-20251001
# ANALYSIS_MODEL is reserved for escalated analysis and reports (CS-09, CS-14); not used yet.
# ANALYSIS_MODEL=claude-sonnet-5

# Backend security
# Comma-separated list of browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000
# Per-IP limit on POST /api/scan/email (slowapi syntax, e.g. 10/minute, 100/hour).
SCAN_RATE_LIMIT=10/minute
# Maximum email body size in bytes (larger bodies get HTTP 413).
MAX_EMAIL_BYTES=51200
# Set to "production" to disable /docs, /redoc and /openapi.json.
ENV=development

# Frontend (public: baked into the browser bundle, so never put secrets here)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Environment
NODE_ENV=development

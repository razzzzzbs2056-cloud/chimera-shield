# ---------------------------------------------------------------------------
# Himalayan Glacier Intelligence Platform -- environment configuration
#
# The platform runs out of the box with NO credentials, using public no-auth
# sources (USGS earthquakes, Open-Meteo weather/forecast/ERA5/elevation).
# Connectors below that require credentials return UNKNOWN until configured --
# they NEVER fabricate data.
# ---------------------------------------------------------------------------

# --- Public connectors (no key needed; defaults shown) ---------------------
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
USGS_EARTHQUAKE_URL=https://earthquake.usgs.gov/fdsnws/event/1/query

# --- Copernicus Data Space (Sentinel-1 SAR + Sentinel-2 optical) -----------
# Register at https://dataspace.copernicus.eu/ then create OAuth client creds.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# --- NASA Earthdata (VIIRS / MODIS surface temperature) --------------------
# Token from https://urs.earthdata.nasa.gov/
NASA_EARTHDATA_TOKEN=

# --- Cesium ion (optional, for 3D Earth base tiles) ------------------------
CESIUM_ION_TOKEN=

# --- Infrastructure --------------------------------------------------------
DATABASE_URL=postgresql+psycopg://glacier:glacier@localhost:5432/glacier
REDIS_URL=redis://localhost:6379/0

# --- Behaviour -------------------------------------------------------------
HTTP_TIMEOUT_S=30
DEFAULT_MONITOR_RADIUS_KM=100

# --- Frontend --------------------------------------------------------------
NEXT_PUBLIC_API_BASE=http://localhost:8000

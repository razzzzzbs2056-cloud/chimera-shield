# Copy to .env (which is git-ignored). Never commit real values. Never paste keys into chat.

# REFLEX model. Needed only when config reflex.kind is "haiku".
ANTHROPIC_API_KEY=

# Alerts (optional). Create a bot with @BotFather; chat id is your user or group id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Exchange keys. Needed only for mode: testnet or live (paper mode uses public data, no keys).
# Create them with TRADE permission only, withdrawals OFF, and an IP allowlist.
# For mode: testnet these must be OKX demo-trading keys.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSPHRASE=

# Live trading interlock. Leave empty. See docs/RUNBOOK.md "Going live" before touching it.
TRADER_LIVE_APPROVED=

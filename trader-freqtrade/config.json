{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "chimera-rule",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,
  "max_open_trades": 3,
  "timeframe": "1h",
  "strategy": "ChimeraRule",
  "cancel_open_orders_on_exit": true,
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "order_types": {
    "entry": "market",
    "exit": "market",
    "emergency_exit": "market",
    "force_entry": "market",
    "force_exit": "market",
    "stoploss": "market",
    "stoploss_on_exchange": false
  },
  "exchange": {
    "name": "okx",
    "key": "",
    "secret": "",
    "password": "",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": [
      "HYPE/USDT:USDT",
      "AAVE/USDT:USDT",
      "SKY/USDT:USDT",
      "UNI/USDT:USDT",
      "TRX/USDT:USDT",
      "LINK/USDT:USDT",
      "XRP/USDT:USDT",
      "ADA/USDT:USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "initial_state": "running",
  "force_entry_enable": false,
  "internals": {
    "process_throttle_secs": 5
  }
}
